[mysqld]
# ── Buffer pool ────────────────────────────────────────────────────────────────
# 3 GB: leaves ~1 GB headroom inside the 4 GB container mem_limit.
innodb_buffer_pool_size         = 3G

# Dump 100% of hot pages on shutdown so we can restore a warm baseline.
innodb_buffer_pool_dump_at_shutdown = ON
innodb_buffer_pool_dump_pct     = 100

# Do NOT auto-load on startup; we load explicitly via scripts/warm-pool.sh
# before each measurement run so every cell starts from the same warm state.
innodb_buffer_pool_load_at_startup = OFF

# ── Packet / connection ─────────────────────────────────────────────────────────
max_allowed_packet = 256M

# Avoid hostname lookups for every new connection (faster connect + no DNS jitter).
skip-name-resolve

# ── LOAD DATA LOCAL INFILE ─────────────────────────────────────────────────────
# Required by seed.sh for bulk CSV loads if used in future iterations.
local_infile = ON

# ── Statistics / planner reproducibility ───────────────────────────────────────
# Disable change buffer to force immediate index writes.
# Ensures index pages are flushed synchronously; benchmark sees real index I/O cost.
innodb_change_buffering = none

# Disable automatic statistics recalculation so query plans don't silently change
# between measurement cells. Statistics are refreshed explicitly via ANALYZE TABLE
# in seed.sh and warmup.sh.
innodb_stats_auto_recalc = 0

# R4 fix: increase persistent statistics sample pages from default 20 to 200.
# With default=20, cardinality estimates for large tables (10M rows at SCALE=full) can
# have >50% estimation error, causing plan flips between member_id range scans and
# idx_issue_status scans mid-campaign without any data change. Setting 200 pages gives
# a much tighter cardinality estimate (CV ~5% for our table sizes) so plans are stable
# across the entire campaign.
innodb_stats_persistent_sample_pages = 200

# R4 fix: disable Adaptive Hash Index (AHI).
# AHI builds dynamic hash indexes on hot InnoDB B-tree pages. In a controlled benchmark
# this is undesirable: (a) AHI amortization cost is non-deterministic across repeats
# (hash building happens on the first access, not on subsequent ones, creating a
# warm/cold asymmetry that correlates with warmup quality), (b) AHI can mask the actual
# B-tree lookup cost we are measuring, making results non-portable to deployments that
# have AHI disabled. Turning it OFF gives a pure, reproducible B-tree access profile.
innodb_adaptive_hash_index = OFF

# ── Logging (keep minimal for benchmark reproducibility) ────────────────────────
# Slow query log helps spot unexpected full-scans during seeding.
slow_query_log      = ON
long_query_time     = 2
slow_query_log_file = /var/lib/mysql/slow.log

# Binlog is useless for this single-node lab (no replication/PITR) and the
# seeder writes ~1GB of binlog per full reseed. Applies on next container start.
skip-log-bin
