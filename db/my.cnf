[mysqld]
# ── Buffer pool ────────────────────────────────────────────────────────────────
# 3 GB: leaves ~1 GB headroom inside the 4 GB container mem_limit.
innodb_buffer_pool_size         = 3G

# Dump 100% of hot pages on shutdown so we can restore a warm baseline.
innodb_buffer_pool_dump_at_shutdown = ON
innodb_buffer_pool_dump_pct     = 100

# Do NOT auto-load on startup; we load explicitly via scripts/warm-pool.sh
# before each measurement run so every cell starts from the same warm state.
innodb_buffer_pool_load_at_startup = OFF

# ── Packet / connection ─────────────────────────────────────────────────────────
max_allowed_packet = 256M

# Avoid hostname lookups for every new connection (faster connect + no DNS jitter).
skip-name-resolve

# ── LOAD DATA LOCAL INFILE ─────────────────────────────────────────────────────
# Required by seed.sh for bulk CSV loads if used in future iterations.
local_infile = ON

# ── Logging (keep minimal for benchmark reproducibility) ────────────────────────
# Slow query log helps spot unexpected full-scans during seeding.
slow_query_log      = ON
long_query_time     = 2
slow_query_log_file = /var/lib/mysql/slow.log
